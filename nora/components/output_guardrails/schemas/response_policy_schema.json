{
  "type": "object",
  "required": [
    "policy_version",
    "template_id",
    "may_continue_with_general_information",
    "personalized_conclusions_prohibited",
    "prohibited_behaviors",
    "required_behaviors",
    "factual_verification"
  ],
  "properties": {
    "policy_version": {
      "const": "response-policy-1.0"
    },
    "template_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "may_continue_with_general_information": {
      "type": "boolean"
    },
    "personalized_conclusions_prohibited": {
      "type": "boolean"
    },
    "prohibited_behaviors": {
      "type": "array",
      "items": {
        "$ref": "finding_schema.json#/properties/reason_code"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "required_behaviors": {
      "type": "array",
      "items": {
        "enum": [
          "URGENT_ESCALATION",
          "CRISIS_SUPPORT",
          "SAFETY_ORIENTED_GUIDANCE",
          "PROFESSIONAL_HELP_ENCOURAGEMENT",
          "EMERGENCY_RESOURCE_BEHAVIOR",
          "CLINICAL_BOUNDARY_STATEMENT"
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "factual_verification": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://output-guardrail.invalid/schemas/response_policy_schema.json"
}
